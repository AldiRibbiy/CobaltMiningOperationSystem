            <Component class="javax.swing.JLabel" name="lblHeroSub">
              <Properties>
                <Property name="text" type="java.lang.String" value="&lt;html&gt;Aplikasi desktop terintegrasi untuk mengelola &lt;b&gt;produksi tambang&lt;/b&gt;, &lt;b&gt;pengangkutan material&lt;/b&gt;, armada &lt;b&gt;kendaraan &amp;amp; driver&lt;/b&gt;, serta &lt;b&gt;monitoring lingkungan&lt;/b&gt; PT. Cobalt — semuanya terpusat dalam satu sistem.&lt;/html&gt;" />
                <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                  <Font name="SansSerif" size="14" style="0" />
