            <Component class="javax.swing.JLabel" name="lblTentangTitle">
              <Properties>
                <Property name="text" type="java.lang.String" value="PT. COBALT" />
                <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                  <Font name="SansSerif" size="26" style="1" />
                </Property>
                <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
                  <Color red="26" green="43" blue="66" type="rgb" />
                </Property>
              </Properties>
            </Component>
            <Component class="javax.swing.JLabel" name="lblTentangLead">
              <Properties>
                <Property name="text" type="java.lang.String" value="Perusahaan pertambangan kobalt dengan pengelolaan operasional yang terpusat dan berkelanjutan." />
                <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                  <Font name="SansSerif" size="13" style="2" />
                </Property>
                <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
                  <Color red="71" green="86" blue="105" type="rgb" />
                </Property>
              </Properties>
            </Component>
            <Component class="javax.swing.JLabel" name="lblTentangP1">
              <Properties>
                <Property name="text" type="java.lang.String" value="&lt;html&gt;PT. Cobalt merupakan perusahaan pertambangan yang mengelola kegiatan &lt;b&gt;produksi tambang&lt;/b&gt;, &lt;b&gt;pengangkutan hasil tambang&lt;/b&gt;, penggunaan kendaraan operasional dan driver, hingga &lt;b&gt;pemantauan kondisi lingkungan&lt;/b&gt;. Seluruh kegiatan berjalan pada lokasi PIT (area penambangan) dan STOCKPILE (penampungan material) yang tersebar di berbagai titik operasional.&lt;/html&gt;" />
                <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                  <Font name="SansSerif" size="13" style="0" />
                </Property>
                <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
                  <Color red="71" green="86" blue="105" type="rgb" />
                </Property>
              </Properties>
            </Component>
            <Component class="javax.swing.JLabel" name="lblTentangP2">
              <Properties>
                <Property name="text" type="java.lang.String" value="&lt;html&gt;Setiap hari, tim operasional mencatat hasil produksi material seperti &lt;i&gt;Cobalt Ore&lt;/i&gt; dan &lt;i&gt;Overburden&lt;/i&gt;, merencanakan pengangkutan menggunakan armada dump truck, serta memantau parameter lingkungan seperti debu, pH air, dan kebisingan. Data yang saling berkaitan tersebut dikelola secara terstruktur agar operasional berjalan aman, efektif, dan berkelanjutan.&lt;/html&gt;" />
                <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                  <Font name="SansSerif" size="13" style="0" />
                </Property>
                <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
                  <Color red="71" green="86" blue="105" type="rgb" />
                </Property>
              </Properties>
            </Component>
            <Component class="javax.swing.JLabel" name="lblTentangP3">
              <Properties>
                <Property name="text" type="java.lang.String" value="&lt;html&gt;Melalui digitalisasi proses operasional, PT. Cobalt mendukung prinsip pertambangan yang bertanggung jawab — sejalan dengan &lt;b&gt;SDG 8&lt;/b&gt; (Pekerjaan Layak dan Pertumbuhan Ekonomi), &lt;b&gt;SDG 12&lt;/b&gt; (Konsumsi dan Produksi yang Bertanggung Jawab), serta &lt;b&gt;SDG 13&lt;/b&gt; (Penanganan Perubahan Iklim).&lt;/html&gt;" />
                <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                  <Font name="SansSerif" size="13" style="0" />
                </Property>
                <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
                  <Color red="71" green="86" blue="105" type="rgb" />
                </Property>
              </Properties>
            </Component>
